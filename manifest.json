{
  "manifest_version": 3,
  "name": "Gemini NavRail",
  "version": "0.1.0",
  "description": "Native-feeling Key Moments / Table of Contents rail for Google Gemini. Streams headings from model responses into a Material 3 sidebar.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/app*", "https://gemini.google.com/app/*"],
      "js": [
        "src/theme-bridge.js",
        "src/heading-extractor.js",
        "src/rail.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
